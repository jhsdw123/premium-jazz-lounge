# =============================================================================
# Premium Jazz Lounge — 환경 변수 템플릿
# 사용법: 이 파일을 .env.local 로 복사한 뒤 실제 값을 채우세요.
# .env.local 은 .gitignore 에 의해 커밋되지 않습니다.
# =============================================================================

# --- Supabase ----------------------------------------------------------------
# Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOi...your-service-role-key...

# (레거시) Supabase Storage 버킷명 — 파일 저장소는 R2 로 이전됨. DB 만 Supabase 유지.
SUPABASE_STORAGE_BUCKET=pjl-jazz-tracks

# --- Cloudflare R2 (S3 호환 파일 스토리지) -----------------------------------
# 곡/템플릿 배경 등 파일 저장소. (DB 메타데이터는 계속 Supabase)
# 값 위치: Cloudflare Dashboard → R2 → Manage R2 API Tokens (Object Read & Write)
# Account ID 는 Endpoint 의 <account>.r2.cloudflarestorage.com 에서 추출.
# 나중에 자체 VPS(MinIO)로 이전 시 이 값들만 교체하면 코드 수정 불필요.
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_BUCKET=pjl-jazz-tracks
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_FORCE_PATH_STYLE=false
# MinIO 등 path-style 백엔드면 S3_FORCE_PATH_STYLE=true

# --- LLM (Phase 3 에서 사용) -------------------------------------------------
# Gemini Pro: 제목 생성 / 번역 메인 엔진
GEMINI_API_KEY=

# OpenAI: 폴백 (선택)
OPENAI_API_KEY=

# --- 서버 --------------------------------------------------------------------
PORT=4001

# --- YouTube OAuth (Phase 5-A) -----------------------------------------------
# Google Cloud Console (PJL-BOT 프로젝트) → APIs & Services → Credentials →
#   "OAuth 2.0 Client IDs" 의 client_id / client_secret 을 그대로 붙여넣기.
# Authorized redirect URI 에는 정확히 아래 YOUTUBE_REDIRECT_URI 값과 같은 URL 등록되어야 함.
# YOUTUBE_TOKEN_PATH 는 access_token + refresh_token 저장 경로 (gitignore: secrets/).
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:4001/auth/youtube/callback
YOUTUBE_TOKEN_PATH=secrets/youtube-token.json
